@baseUrl = http://localhost:3001/api

### Registrar un usuario nuevo (201)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Sakura Kinomoto",
  "correo": "sakura@kittyimport.com",
  "password": "mipassword123"
}

### Iniciar sesión y guardar token en variable (200)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "correo": "sakura@kittyimport.com",
  "password": "mipassword123"
}

### Variable con el token obtenido del login
@token = {{login.response.body.token}}

### Obtener el usuario autenticado (200)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### Caso de error: Registro con correo repetido (400)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Sakura Duplicada",
  "correo": "sakura@kittyimport.com",
  "password": "mipassword123"
}

### Caso de error: Registro con contraseña corta menor a 8 caracteres (400)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Usuario Clave Corta",
  "correo": "corto@kittyimport.com",
  "password": "12345"
}

### Caso de error: Login con contraseña incorrecta (401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "correo": "sakura@kittyimport.com",
  "password": "passwordequivocado"
}

### Caso de error: Petición a ruta protegida sin token (401)
GET {{baseUrl}}/productos

### Caso de error: Petición con token inventado (401)
GET {{baseUrl}}/productos
Authorization: Bearer token.inventado.invalido

### Caso de error: GET de un ID inexistente (404)
GET {{baseUrl}}/productos/99999
Authorization: Bearer {{token}}

### Caso de error: POST con un campo obligatorio vacío (400)
POST {{baseUrl}}/categorias
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "",
  "descripcion": "Categoría sin nombre"
}

### Caso de error: DELETE de una categoría con productos asociados (409)
DELETE {{baseUrl}}/categorias/1
Authorization: Bearer {{token}}

### Caso de error: POST de producto con categoria_id inexistente (400)
POST {{baseUrl}}/productos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Peluche Prueba Categoría Inexistente",
  "precio_compra_cny": 20,
  "precio_venta": 150,
  "stock": 5,
  "categoria_id": 9999,
  "proveedor_id": 1
}

### Obtener todos los proveedores (200)
GET {{baseUrl}}/proveedores
Authorization: Bearer {{token}}

### Obtener un proveedor por ID (200)
GET {{baseUrl}}/proveedores/1
Authorization: Bearer {{token}}

### Crear un proveedor (201)
POST {{baseUrl}}/proveedores
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Kawaii Bear Wholesale",
  "plataforma": "1688",
  "ciudad": "Dongguan",
  "contacto": "wechat: kawaiibear_dg",
  "calificacion": 5
}

### Actualizar un proveedor (200)
PUT {{baseUrl}}/proveedores/5
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Kawaii Bear Wholesale Oficial",
  "plataforma": "1688",
  "ciudad": "Dongguan",
  "contacto": "wechat: kawaiibear_oficial",
  "calificacion": 5
}

### Eliminar un proveedor (204)
DELETE {{baseUrl}}/proveedores/5
Authorization: Bearer {{token}}

### Obtener todas las categorías (200)
GET {{baseUrl}}/categorias
Authorization: Bearer {{token}}

### Obtener una categoría por ID (200)
GET {{baseUrl}}/categorias/1
Authorization: Bearer {{token}}

### Crear una categoría (201)
POST {{baseUrl}}/categorias
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Papelería",
  "descripcion": "Libretas, plumas de gel y notas adhesivas kawaii"
}

### Actualizar una categoría (200)
PUT {{baseUrl}}/categorias/5
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Papelería Kawaii",
  "descripcion": "Libretas, plumas de gel, estuches y notas adhesivas"
}

### Eliminar una categoría (204)
DELETE {{baseUrl}}/categorias/5
Authorization: Bearer {{token}}

### Obtener todos los productos (200)
GET {{baseUrl}}/productos
Authorization: Bearer {{token}}

