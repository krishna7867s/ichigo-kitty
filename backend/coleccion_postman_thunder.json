{
  "info": {
    "name": "Ichigo Kitty (Kitty Import) - API Completa + Auth JWT",
    "_postman_id": "a1b2c3d4-e5f6-4789-9012-3456789abcde",
    "description": "Colección de pruebas para Postman y Thunder Client con Auth JWT, CRUDs de las 5 entidades y casos de error 400, 401, 404 y 409.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Autenticación (JWT)",
      "item": [
        {
          "name": "POST /auth/register - Registrar usuario (201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Sakura Kinomoto\",\n  \"correo\": \"sakura@kittyimport.com\",\n  \"password\": \"mipassword123\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "POST /auth/login - Iniciar sesión (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) { pm.collectionVariables.set('token', res.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"sakura@kittyimport.com\",\n  \"password\": \"mipassword123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "GET /auth/me - Obtener perfil autenticado (200)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Casos de Error (400, 401, 404, 409)",
      "item": [
        {
          "name": "401 - Petición sin token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/productos"
          }
        },
        {
          "name": "401 - Petición con token inventado",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer token.inventado.invalido" }],
            "url": "{{baseUrl}}/productos"
          }
        },
        {
          "name": "400 - Registro con correo repetido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Sakura Duplicada\",\n  \"correo\": \"sakura@kittyimport.com\",\n  \"password\": \"mipassword123\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "400 - Registro con contraseña corta (< 8 caracteres)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Clave Corta\",\n  \"correo\": \"corto@kittyimport.com\",\n  \"password\": \"12345\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "401 - Login con contraseña incorrecta",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"sakura@kittyimport.com\",\n  \"password\": \"claveincorrecta\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "404 - GET de un ID inexistente",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/productos/99999"
          }
        },
        {
          "name": "400 - POST con un campo obligatorio vacío",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"descripcion\": \"Categoría sin nombre\"\n}"
            },
            "url": "{{baseUrl}}/categorias"
          }
        },
        {
          "name": "409 - DELETE de una categoría con productos asociados",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/categorias/1"
          }
        },
        {
          "name": "400 - POST de producto con categoria_id inexistente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Peluche Prueba\",\n  \"precio_compra_cny\": 20,\n  \"precio_venta\": 150,\n  \"stock\": 5,\n  \"categoria_id\": 9999,\n  \"proveedor_id\": 1\n}"
            },
            "url": "{{baseUrl}}/productos"
          }
        }
      ]
